{
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "Bash(pip install:*)",
      "mcp__claude_ai_PDF_Viewer__display_pdf"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.claude/scripts/session-logger.js\"",
            "timeout": 15
          }
        ],
        "description": "Save human-readable session log to .claude/session-logs/",
        "id": "stop:session-logger"
      }
    ]
  }
}
