{
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "Bash(pip install:*)",
      "mcp__claude_ai_PDF_Viewer__display_pdf",
      "Bash(dir *)",
      "PowerShell(Head *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.claude/scripts/session-logger.js\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
